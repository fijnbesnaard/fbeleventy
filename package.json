{
  "name": "eleventy-starter",
  "version": "1.0.0",
  "description": "Eleventy + Sveltia CMS starter template",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm-run-all --parallel dev:*",
    "dev:11ty": "eleventy --serve",
    "dev:css": "postcss src/css/main.css --output public/css/main.css --watch",
    "dev:cms": "npx @sveltia/cms-backend-proxy",
    "build": "npm-run-all build:css build:11ty",
    "build:css": "NODE_ENV=production postcss src/css/main.css --output public/css/main.css",
    "build:11ty": "eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0"
  }
}
