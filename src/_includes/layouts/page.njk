{% extends "layouts/base.njk" %}

{% block content %}
  <article class="section">
    <div class="container">
      {% if title %}
        <h1>{{ title }}</h1>
      {% endif %}
      {{ content | safe }}
    </div>
  </article>
{% endblock %}
