{#- ============================================================
    LAYOUT: post.njk
    Blog post layout. Extends base.njk.
    ============================================================ #}

{% extends "layouts/base.njk" %}

{% block content %}
  {%- set t = i18n[locale | default(site.language)] -%}

  <article class="section">
    <div class="container container--narrow">

      <header class="stack stack--sm">
        {% if tags %}
          <ul class="flex flex--wrap" role="list" style="gap: var(--space-2)">
            {% for tag in tags %}
              {% if tag !== "posts" %}
                <li>
                  <a href="/tags/{{ tag }}/" class="text-sm text-muted">
                    #{{ tag }}
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <h1>{{ title }}</h1>

        <p class="text-muted text-sm">
          <time datetime="{{ page.date | dateISO }}">
            {{ t.post.publishedOn }} {{ page.date | dateDisplay }}
          </time>
        </p>
      </header>

      <hr style="margin-block: var(--space-8)">

      <div class="prose">
        {{ content | safe }}
      </div>

      <hr style="margin-block: var(--space-8)">

      <a href="/blog/" class="text-sm">← {{ t.post.backToBlog }}</a>

    </div>
  </article>
{% endblock %}
