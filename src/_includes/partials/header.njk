{#- ============================================================
    PARTIAL: header.njk
    Site header with navigation and theme toggle.
    Nav items are defined here — move to _data/nav.js if
    you need CMS-driven navigation.
    ============================================================ #}

{%- set t = i18n[locale | default(site.language)] -%}

{%- set navItems = [
  { label: t.nav.home,    url: "/" },
  { label: t.nav.about,   url: "/over/" },
  { label: t.nav.blog,    url: "/blog/" },
  { label: t.nav.contact, url: "/contact/" }
] -%}

<header class="site-header">
  <div class="container">
    <div class="flex flex--between">

      {# Logo / site name #}
      <a href="/" class="site-header__logo" aria-label="{{ site.title }}">
        {{ site.title }}
      </a>

      {# Desktop navigation #}
      <nav class="site-header__nav hide-mobile" aria-label="Hoofdnavigatie">
        <ul class="flex" role="list" style="gap: var(--space-6); list-style: none; padding: 0;">
          {% for item in navItems %}
            <li>
              <a href="{{ item.url }}"
                 {% if page.url === item.url %}aria-current="page"{% endif %}>
                {{ item.label }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="flex" style="gap: var(--space-3); align-items: center;">
        {# Theme toggle #}
        <button class="theme-toggle"
                aria-label="{{ t.aria.toggleTheme }}"
                onclick="toggleTheme()">
          <span class="theme-toggle__icon theme-toggle__icon--light">☀️</span>
          <span class="theme-toggle__icon theme-toggle__icon--dark">🌙</span>
        </button>

        {# Mobile menu toggle #}
        <button class="menu-toggle hide-tablet"
                aria-label="{{ t.aria.openMenu }}"
                aria-expanded="false"
                aria-controls="mobile-menu"
                onclick="toggleMenu(this)">
          <span></span><span></span><span></span>
        </button>
      </div>

    </div>
  </div>

  {# Mobile menu #}
  <nav id="mobile-menu" class="mobile-menu" aria-hidden="true" hidden>
    <div class="container">
      <ul class="stack stack--sm" role="list" style="list-style: none; padding: 0;">
        {% for item in navItems %}
          <li>
            <a href="{{ item.url }}"
               {% if page.url === item.url %}aria-current="page"{% endif %}>
              {{ item.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>
